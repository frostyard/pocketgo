# Build outputs (AGENTS.md: build outputs are not committed). make build
# writes to build/. A bare `go build` writes its command beside the package it
# builds: in the module root, or in the command's directory under cmd/.
/build/
/service/pocketd
/service/cmd/pocketd/pocketd
*.exe
# Agent worktrees that Claude Code creates beside the checkout.
/.claude/worktrees/
# The MyGo client, removed by ADR-0071, wrote its packages to desktop/build/
# and its bundle to desktop/.mygo/; a checkout that built it may still hold
# them.
/desktop/build/
/desktop/.mygo/

/desktop/pocket-nsgo
/desktop/cmd/pocket-nsgo/pocket-nsgo
/desktop/cmd/pocket-nsgo/dist/
/desktop/**/.nsgo/
